          "expr": "(sum(rate(http_request_duration_highr_seconds_count{namespace=\"$namespace\", status=~\"5.*\"}[1m])) or on() vector(0)) / (sum(rate(http_request_duration_highr_seconds_count{namespace=\"$namespace\"}[1m])) or on() vector(1)) * 100",
