          "expr": "sum(rate(http_request_duration_highr_seconds_count{namespace=\"$namespace\"}[1m]))",
          "legendFormat": "Total Requests",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Traffic (HTTP Request Rate)",
      "type": "timeseries"
